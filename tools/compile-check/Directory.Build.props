<Project>
  <!--
    어셈블리별 컴파일 확인의 공통 설정이다. Unity 프로젝트의 일부가 아니다(Assets 밖).
    Unity가 스크립트를 컴파일할 때의 어셈블리 경계·참조·전처리 기호를 흉내 내어,
    Unity를 실행하지 않고 컨트롤러·HUD·메이커·로비 코드까지 컴파일 오류를 찾는다.

    실행: bash ./scripts/run-compile-check.sh  (설명: docs/project/logic-tests.md)
    경로 속성(SrpUnityData, SrpPlayerManaged, SrpLibrary, SrpNUnitDll)과 SrpVariant는 실행 스크립트가 넘긴다.
    dotnet build를 직접 부르면 Directory.Build.targets의 확인에서 실패한다.

    참조 구성의 근거는 Unity 6000.3.13f1이 실제로 쓴 컴파일러 응답 파일
    (Library/Bee/artifacts/*.dag/<어셈블리>.rsp)이다.
  -->
  <PropertyGroup>
    <!-- 확인할 Unity 프로젝트 루트. 기본은 이 저장소다. 실행 스크립트의 인자(source)로 바꾼다. -->
    <SrpSourceRoot Condition="'$(SrpSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</SrpSourceRoot>
    <SrpSourceRootFull>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(SrpSourceRoot)'))))</SrpSourceRootFull>
    <SrpAssets>$(SrpSourceRootFull)Assets</SrpAssets>

    <SrpEditorManaged>$(SrpUnityData)/Managed/UnityEngine</SrpEditorManaged>
    <SrpNetStandard>$(SrpUnityData)/NetStandard</SrpNetStandard>
    <SrpNet48>$(SrpUnityData)/UnityReferenceAssemblies/unity-4.8-api</SrpNet48>
    <SrpScriptAssemblies>$(SrpLibrary)/ScriptAssemblies</SrpScriptAssemblies>

    <!-- 이 어셈블리가 들어가는 변형. 테스트·에디터 전용 어셈블리는 csproj에서 editor로 좁힌다. -->
    <SrpVariants>editor;player</SrpVariants>

    <!-- 산출물은 변형별로 나눠 tools/compile-check/obj, bin 아래에 둔다(.gitignore 대상). -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(SrpVariant)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/$(SrpVariant)/$(MSBuildProjectName)/</BaseOutputPath>
    <SrpReportFile>$(MSBuildThisFileDirectory)obj/$(SrpVariant)/$(MSBuildProjectName).report.txt</SrpReportFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 프레임워크 이름은 SDK를 움직이기 위한 것일 뿐이다. 기본 라이브러리 참조는 Unity가 쓰는 DLL로 직접 준다. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <!-- Unity 6의 C# 버전과 프로젝트 설정(unsafe 금지)에 맞춘다. -->
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 컴파일 대상은 csproj에 적은 저장소 소스뿐이어야 한다. SDK가 끼워 넣는 파일과 기호를 모두 끈다. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <!-- asmdef처럼 직접 적은 어셈블리만 보이게 한다. 이게 없으면 경계를 넘는 참조 오류를 놓친다. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <!-- Unity가 컴파일러에 주는 nowarn과 같다(0169·0649는 프로젝트 설정의 suppressCommonWarnings). -->
    <NoWarn>CS0169;CS0649;CS0282;CS1701;CS1702</NoWarn>
    <!-- 컴파일 결과만 본다. 실행 파일로 쓰지 않으므로 부가 산출물은 만들지 않는다. -->
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!--
      asmdef·asmref가 있는 폴더. 미리 정의된 어셈블리(Assembly-CSharp, Assembly-CSharp-Editor)는 이 폴더들을 뺀
      나머지를 컴파일한다. 새 asmdef 폴더가 생기면 어느 프로젝트에도 들어가지 않게 되고,
      실행 스크립트의 소스 대조가 그 파일들을 알려 준다.
    -->
    <SrpAsmdefFile Include="$(SrpAssets)/**/*.asmdef;$(SrpAssets)/**/*.asmref" />
  </ItemGroup>
</Project>
